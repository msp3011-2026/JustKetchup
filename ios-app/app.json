{
  "expo": {
    "name": "JustKetchup",
    "slug": "justketchup",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "justketchup",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.msp3011.justketchup",
      "infoPlist": {
        "NSContactsUsageDescription": "JustKetchup uses your contacts so you can choose the people you want to stay in touch with. Your contacts are never shared.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.msp3011.justketchup",
      "permissions": [
        "READ_CONTACTS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-contacts",
        {
          "contactsPermission": "JustKetchup uses your contacts so you can choose the people you want to stay in touch with."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EA580C"
        }
      ]
    ],
    "extra": {
      "router": {}
    },
    "owner": "msp3011"
  }
}
